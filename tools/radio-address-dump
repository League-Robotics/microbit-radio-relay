#!/usr/bin/env python3
"""radio-address-dump -- protocol v1, one file per repository.

Every repository that implements the name <-> (channel, group) mapping exposes
an executable at tools/radio-address-dump with exactly this contract, so a
single checker (scripts/radio_address_conformance.py in microbit-radio-relay,
vendorable) can compare every implementation in every repo:

    tools/radio-address-dump --list
        one implementation id per line, e.g. "python", "firmware-cpp",
        "makecode-ts"
    tools/radio-address-dump <id>
        the spec's canonical form on stdout: for n = 0..3124 in order, one line
        "<name>,<channel>,<group>" -- 3125 lines, nothing else. Exit 0.
        If that implementation cannot run on this machine (no compiler, no
        toolchain), print one line to stderr and exit 3; the checker reports
        it as unavailable rather than as a mismatch.

The canonical form and its sha256 are defined by docs/radio-addressing.md in
pxt-nezha-diffdrive ($.properties.full_space_sha256 of the vectors file).

This repository's implementations:
    python         mbrelay.naming (the daemon's view of !N)
    firmware-cpp   source/relay/naming.h, the code the relay firmware runs,
                   compiled for the host via server/tests/conformance/naming_dump.cpp
"""

from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UNAVAILABLE = 3


def dump_python() -> int:
    sys.path.insert(0, str(ROOT / "server" / "src"))
    from mbrelay.naming import canonical_form
    sys.stdout.write(canonical_form())
    return 0


def dump_firmware_cpp() -> int:
    cxx = shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
    if cxx is None:
        print("firmware-cpp: no host C++ compiler (c++/g++/clang++) on PATH", file=sys.stderr)
        return UNAVAILABLE
    src = ROOT / "server" / "tests" / "conformance" / "naming_dump.cpp"
    with tempfile.TemporaryDirectory(prefix="naming_dump") as tmp:
        exe = Path(tmp) / "naming_dump"
        build = subprocess.run(
            [cxx, "-std=c++11", "-O1", "-Wall", "-I", str(ROOT / "source" / "relay"),
             str(src), "-o", str(exe)],
            capture_output=True, text=True)
        if build.returncode != 0:
            sys.stderr.write(build.stderr)
            return 1
        run = subprocess.run([str(exe)], capture_output=True, text=True)
        sys.stdout.write(run.stdout)
        sys.stderr.write(run.stderr)
        return run.returncode


IMPLEMENTATIONS = {
    "python": dump_python,
    "firmware-cpp": dump_firmware_cpp,
}


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__, file=sys.stderr)
        return 2
    if argv[0] == "--list":
        print("\n".join(IMPLEMENTATIONS))
        return 0
    impl = IMPLEMENTATIONS.get(argv[0])
    if impl is None:
        print(f"unknown implementation {argv[0]!r}; try --list", file=sys.stderr)
        return 2
    return impl()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
