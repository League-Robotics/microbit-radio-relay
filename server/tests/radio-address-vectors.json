    "full_space_sha256_note": "D1 -- forward only: '<name>,<channel>,<group>\\n' for n = 0..3124. Never calls decode or reverse; a bisector only.",
    "conformance_sha256": "305d6ee08cfae978fe13e1179c6047a56e1b0b1abe23c2cb757f01461cf2d35f",
    "conformance_sha256_note": "D2 -- the gate: '<name>,<channel>,<group>,<decode(name)>,<reverse(channel,group)>\\n' for n = 0..3124.",
