  "$comment": "Transcribed from radio-robot-lib docs/design/radio-addressing.md (wiki: 'Radio addressing', updated 2026-09-13). That document is normative; if they disagree, it wins and this file is wrong. Replaces the earlier mirror of pxt-nezha-diffdrive's vectors for the channel = 25 + 2*(n % 25) map. Key names under properties are kept so scripts/radio_address_conformance.py reads either file.",
  "spec": "radio-robot-lib docs/design/radio-addressing.md",
  "version": "2.0.0",
  "algorithm": {
    "consonants_at_positions_0_2_4": "zvgpt",
    "vowels_at_positions_1_3": "uoiea",
    "decode": "n = 0; for p in 0..4: n = n*5 + index_in_alphabet(name[p])",
    "channel": "11 + (n % 73)",
    "group": "15 + (n % 241)",
    "reverse": "reject unless 11 <= channel <= 83 and 15 <= group <= 255; c = channel - 11; g = group - 15; n = c + 73 * (((g - c + 241) * 208) % 241); reject unless n < 3125; encode(n)",
    "normalize": "trim ASCII whitespace; map A-Z to a-z",
    "accept": "^[zvgpt][uoiea][zvgpt][uoiea][zvgpt]$",
    "encode": "n -> name, the inverse of decode: for p = 4 down to 0: name[p] = alphabet(p)[n % 5]; n = n / 5"
  },
  "ranges": {
    "n": [0, 3124],
    "channel": {"min": 11, "max": 83, "count": 73},
    "group": {"min": 15, "max": 255, "count": 241}
  },
  "properties": {
    "total_names": 3125,
    "distinct_pairs": 3125,
    "names_per_channel": {"11-69": 43, "70-83": 42},
    "names_per_group": {"15-247": 13, "248-255": 12},
