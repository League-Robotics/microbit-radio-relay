# Example mbrelay configuration.
#
# Search order, lowest precedence first:
#   /etc/mbrelay/mbrelay.toml
#   /etc/mbrelay/conf.d/*.toml
#   $XDG_CONFIG_HOME/mbrelay/mbrelay.toml
#   ./mbrelay.toml
#   MBRELAY_* environment variables
#   command-line flags
#
# `mbrelay config show` prints the merged result and which layer won each key.
# Unknown keys are a startup ERROR, not a warning -- a typo here must not leave
# the service running with a silently different setting.

[server]
bind = "0.0.0.0"
port = 8760

# Sent (plus CRLF) before the socket closes when nothing is free. A byte pipe has
# no error channel, so the reason goes out in the relay's own comment syntax:
# clients that skip "#" lines are unaffected, humans on netcat get an answer.
# Set to "" to close with zero bytes instead.
reject_message = "# ERROR: no relay available ({total} devices, {busy} in use, {releasing} being handed back)"

# 0 = reject immediately. Releasing a board takes 2-3s (close, reopen to reset,
# confirm, restore, verify), so a client that reconnects the instant it
# disconnects can be refused. Raise this for test harnesses that do that.
acquire_wait_ms = 0

# Prefer to hand a returning client a board it had recently, so per-robot work
# keeps the same hardware and its logs stay comparable. A preference, not a
# reservation: if the board is taken you get the least-used free one instead.
# Set false for strict least-used rotation.
sticky_allocation = true
sticky_ttl_s = 3600
sticky_max_clients = 256

# Prepend "# session <id>" so a client can correlate its socket with
# `mbrelay status` / `mbrelay kick`. Off by default: a real serial port never
# sends it, and byte-for-byte equivalence is the point of the service.
announce_session = false

# banner: replay the board's announcement first, as a direct serial open would
# none:   send nothing; the client sends HELLO itself
# raw:    forward every setup byte, normalize echoes included (debug only)
preamble = "banner"

# Reap clients whose laptop went to sleep instead of letting them hold a relay.
keepalive = true

[devices]
# Empty allow list means every micro:bit found. Both accept UIDs or names.
allow = []
deny = []

# Only the C++/CODAL relay firmware can be driven. The older MakeCode RADIORELAY
# boards announce themselves too, but do not accept !ECHO ON / !MODE, so the
# daemon cannot verify it restored a known state.
allow_roles = ["RADIOBRIDGE"]

# [devices.labels]
# Friendly names keyed by DAPLink UID. Careful: the UID's *tail* is the interface
# chip and is identical across boards from the same batch -- the distinguishing
# field is in the middle. `mbrelay devices` prints it.
# "9906360200052820b8e12372c44f4f67000000006e052820" = "bench-1"

[admin]
socket = "/run/mbrelay/mbrelay.sock"
socket_mode = "0660"
# socket_group = "mbrelay"     # operators join this group to run admin commands
allow_shutdown = false          # systemd owns the lifecycle; use systemctl

[firmware]
# Only needed for `mbrelay flash`; the daemon itself never touches these.
hex = "/opt/microbit-relay/MICROBIT.hex"
# Directory holding pyocd.yaml with `chip_erase: chip`. pyocd reads it from its
# cwd, and without it a sector erase fails on the nRF52833 MBR region at 0x0.
pyocd_config = "/opt/microbit-relay/pyocd.yaml"

[state]
dir = "/var/lib/mbrelay"
# The systemd unit's TimeoutStopSec must exceed this, or systemd kills the
# daemon while it is still restoring boards to factory defaults.
shutdown_grace_s = 20

[log]
level = "info"
format = "text"                 # "json" for log shippers

[mdns]
# Announce this host on the LAN, so clients can run `mbrelay connect` with no
# address and `mbrelay discover` can list the fleet. Needs avahi-utils installed
# and avahi-daemon running; without them the daemon logs one warning at startup
# and serves boards exactly as before. Discovery is never a prerequisite.
enabled = true

# _mbrelay._tcp is not registered with IANA, which is legal -- RFC 6763 allows
# up to 15 characters. Change it only if you run two independent fleets on one
# LAN, and change it on the clients too.
service = "_mbrelay._tcp"

# The name shown by `mbrelay discover`. Empty means the short hostname, which is
# unique on a LAN and readable in a picker.
# instance = "bench-1"

# Resolved with which(1), falling back to the other known publishers, so a macOS
# dev host advertises through dns-sd without any configuration.
publish_cmd = "avahi-publish"

[registry]
# The name registry: which (channel, group) each robot is actually on.
#
# A micro:bit's name derives a DEFAULT address all by itself -- that is what
# `mbrelay names` shows as source "derived" -- but the mapping has only 25
# channels, so 125 names share each one. When two robots collide you move one,
# and the registry is what records where it went. Asking for a name that has
# never been seen always answers: the default is computed and recorded.
#
# Served over HTTP on its own port, because the callers are usually not on this
# box (building a robot config, running a channel survey):
#
#   curl relay-host:8761/names               # everything on record
#   curl relay-host:8761/names/tovez         # where tovez is; creates on miss
#   curl -X PUT relay-host:8761/names/tovez -d '{"channel": 12, "group": 4}'
#   curl -X DELETE relay-host:8761/names/tovez        # back to derived
#
# There is no authentication. This is an internal lab service whose entire
# content is which radio channel a robot sits on -- which anyone with an
# antenna can determine anyway. Do not expose the port off your LAN.
enabled = true

# Empty follows server.bind. Set 127.0.0.1 to keep the registry on-box.
bind = ""
port = 8761

# Pinned assignments, as "<channel>/<group>". This is where a channel survey's
# output belongs: a pin outranks anything set through the API, so a restart
# cannot quietly reinstate a stale learned value. Changing a pin needs a daemon
# restart, and `mbrelay names set` refuses to shadow one.
#
# Moving a robot is a TWO-SIDED change: the robot derives its own address from
# its own name at boot, so it has to be reconfigured to match (the deploy-time
# channel/group constants in pxt-nezha-diffdrive). Pinning here only tells the
# relay where to tune.
# [registry.names]
# tovez = "12/4"
# vevov = "14/4"
